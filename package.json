{
  "name": "polymarket-geopolitical-agent",
  "version": "0.1.0",
  "description": "Autonomous geopolitical trading agent for Polymarket",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "build:emit": "tsc",
    "start": "node dist/index.js",
    "cron:trade": "npx tsx src/execution/index.ts",
    "cron:monitor": "npx tsx src/monitor/index.ts",
    "cron:ingest": "npx tsx src/ingestion/index.ts",
    "probe:simmer": "npx tsx scripts/probe-simmer.ts",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --passWithNoTests",
    "test:unit": "node --experimental-vm-modules node_modules/.bin/jest --testPathPattern=src/",
    "lint": "eslint 'src/**/*.ts' 'scripts/**/*.ts'",
    "format": "prettier --write 'src/**/*.ts' 'scripts/**/*.ts'"
  },
  "dependencies": {
    "@ethersproject/wallet": "^5.8.0",
    "@google/generative-ai": "^0.24.1",
    "@polymarket/clob-client": "^5.8.0",
    "axios": "^1.13.6",
    "cheerio": "^1.2.0",
    "ethers": "^6.16.0",
    "ioredis": "^5.3.2",
    "openai": "^6.32.0",
    "rss-parser": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/cheerio": "^0.22.35",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "dotenv": "^17.3.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
