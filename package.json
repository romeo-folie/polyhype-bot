{
  "name": "polymarket-geopolitical-agent",
  "version": "0.1.0",
  "description": "Autonomous geopolitical trading agent for Polymarket",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.0.0",
    "npm": "^10.0.0"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "build:emit": "tsc",
    "start": "node dist/index.js",
    "worker:copytrade": "npx tsx src/copytrade/worker.ts",
    "monitor:futures": "npx tsx src/monitor/futuresMonitor.ts",
    "cron:trade": "npx tsx src/execution/index.ts",
    "cron:monitor": "npx tsx src/monitor/index.ts",
    "cron:ingest": "npx tsx src/ingestion/index.ts",
    "cron:spot": "npx tsx src/spot/index.ts",
    "cron:arb": "npx tsx src/arb/index.ts",
    "worker:spot-feed": "npx tsx src/spot/feeds/manager.ts",
    "worker:arb": "npx tsx src/arb/worker.ts",
    "worker:telegram": "npx tsx src/ingestion/telegramMonitor.ts",
    "warmer:market": "tsx src/spot/marketWarmer.ts",
    "cron:shortlist": "npx tsx src/copytrade/shortlist.ts",
    "cron:calibrate": "npx tsx src/cron/calibrate.ts",
    "cron:watchlist": "npx tsx src/cron/refreshWatchlist.ts",
    "sync-env": "npx tsx scripts/sync-env.ts",
    "probe:simmer": "npx tsx scripts/probe-simmer.ts",
    "probe:clob-allowance": "npx tsx scripts/probe-clob-allowance.ts",
    "test": "vitest run --reporter=verbose",
    "test:unit": "vitest run --reporter=verbose",
    "lint": "eslint 'src/**/*.ts' 'scripts/**/*.ts'",
    "format": "prettier --write 'src/**/*.ts' 'scripts/**/*.ts'",
    "monitor:dashboard": "./scripts/monitor-dashboard.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@ethersproject/wallet": "^5.8.0",
    "@google/generative-ai": "^0.24.1",
    "@msgpack/msgpack": "^3.1.3",
    "@polymarket/builder-relayer-client": "^0.0.8",
    "@polymarket/clob-client": "^5.8.0",
    "@pythnetwork/client": "^2.22.1",
    "@solana/web3.js": "^1.98.4",
    "axios": "^1.13.6",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.0",
    "ethers": "^6.16.0",
    "input": "^1.0.1",
    "ioredis": "^5.3.2",
    "node-pg-migrate": "^7.9.1",
    "openai": "^6.32.0",
    "postgres": "^3.4.9",
    "prebuilt-tdlib": "^0.1008062.2",
    "rss-parser": "^3.13.0",
    "tdl": "^8.1.0",
    "tsx": "^4.7.0",
    "ws": "^8.20.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "@types/cheerio": "^0.22.35",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3",
    "vitest": "^1.6.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": ">=4.0.0",
    "@rollup/rollup-linux-x64-musl": ">=4.0.0"
  }
}
