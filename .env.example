# ============================================================
# polymarket-geopolitical-agent — environment configuration
#
# Copy to .env and fill in the required values.
# Uncomment optional lines to override defaults.
# ============================================================

# ── Required ─────────────────────────────────────────────────

# Redis — deduplication, position ledger, job locks
REDIS_URL=redis://localhost:6379

# Simmer API — primary trade execution venue
# Register: curl -X POST https://api.simmer.markets/api/sdk/agents/register \
#   -H "Content-Type: application/json" \
#   -d '{"name": "pga", "description": "Polymarket geopolitical agent"}'
# Then open the returned claim_url to link your Polymarket wallet.
SIMMER_API_KEY=sk_live_...

# LLM — at least one required (OpenAI recommended; Gemini as fallback)
OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...

# Telegram — trade and position notifications
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=...

# Polymarket wallet — required for direct CLOB execution (Simmer fallback)
# WARNING: never commit a funded private key; load from a secret manager in prod
POLYGON_WALLET_PRIVATE_KEY=0x...

# ── LLM provider & models ────────────────────────────────────

# LLM_PROVIDER=openai            # openai | gemini
# OPENAI_MODEL=gpt-4o-mini       # gpt-4o, gpt-4.1-mini, etc.
# GEMINI_MODEL=gemini-2.5-flash  # gemini-2.5-pro, etc.

# ── Position sizing ─────────────────────────────────────────

# MAX_BET_FRACTION=0.05          # max 5% of bankroll per trade
# DIVERGENCE_THRESHOLD=0.10      # min edge to enter a trade (10%)
# URGENCY_THRESHOLD=8            # min OSINT urgency score (1–10) to map markets

# ── Exit rules ───────────────────────────────────────────────

# TAKE_PROFIT_THRESHOLD=0.25     # exit when up 25%
# STOP_LOSS_THRESHOLD=0.30       # exit when down 30%
# REEVAL_ENABLED=true            # re-evaluate open positions against fresh OSINT
# REEVAL_EDGE_FLOOR=0.03         # exit re-eval if edge drops below 3%

# ── Direct CLOB fallback ─────────────────────────────────────
#
# CLOB auth / signature type matrix:
#
#   Type | Account type              | POLYGON_WALLET_PRIVATE_KEY source  | POLYMARKET_FUNDER_ADDRESS
#   -----+---------------------------+------------------------------------+---------------------------
#     0  | EOA (MetaMask/hardware)   | Your wallet's private key          | Not needed (defaults to signer)
#     1  | POLY_PROXY (Magic/Google) | Magic-linked wallet's private key  | Your Polymarket funder address (REQUIRED)
#     2  | POLY_GNOSIS_SAFE          | Gnosis Safe owner key              | Safe contract address (REQUIRED)
#
# Common setup — OAuth/Google (Magic proxy):
#   POLYMARKET_SIGNATURE_TYPE=1
#   POLYGON_WALLET_PRIVATE_KEY=0x<magic-linked-wallet-private-key>
#   POLYMARKET_FUNDER_ADDRESS=0x<your-polymarket-funder-address>
#
# Common setup — Direct MetaMask/hardware wallet (EOA):
#   POLYMARKET_SIGNATURE_TYPE=0
#   POLYGON_WALLET_PRIVATE_KEY=0x<your-wallet-private-key>
#   (POLYMARKET_FUNDER_ADDRESS not required)
#
# Troubleshooting:
#   "Could not create api key" at startup — EXPECTED for existing accounts (derive path used next)
#   allowance=0 in probe — run updateBalanceAllowance or approve CLOB contract on Polymarket UI
#   balance=0 — deposit USDC to your Polymarket account first
#
# CLOB_FALLBACK_ENABLED=true     # enable direct CLOB when Simmer can't fill; set false to disable entirely
# CLOB_ORDER_TYPE=FAK            # FAK (fill-and-kill) or FOK (fill-or-kill)
# POLYMARKET_SIGNATURE_TYPE=0    # 0=EOA, 1=POLY_PROXY (Magic/Google OAuth), 2=POLY_GNOSIS_SAFE
# POLYMARKET_FUNDER_ADDRESS=0x...  # Required for type 1 and 2; omit for type 0

# ── WebSocket price feed ─────────────────────────────────────
# Real-time YES ask prices via Polymarket CLOB WebSocket.
# Reduces latency on price checks vs Gamma REST polls.

# WS_ENABLED=true                # disable to force REST-only mode (useful in CI)

# ── Spot price monitor (cron:spot) ───────────────────────────
# Detects significant moves in crypto/commodity spot prices and
# maps them to correlated Polymarket prediction markets.

SPOT_MONITOR_ENABLED=true        # enable spot signal pipeline
# SPOT_MOVE_THRESHOLD=3          # % price move to trigger a signal (default: 3%)
# SPOT_LOOKBACK_MINUTES=5        # lookback window for move detection
# SPOT_COOLDOWN_MINUTES=30       # min minutes between trades on the same asset
# SPOT_DIVERGENCE_THRESHOLD=0.12 # min edge on correlated market to trade (12%)
# SPOT_CRYPTO_ASSETS=bitcoin,ethereum  # CoinGecko IDs to monitor
# SPOT_COMMODITY_ASSETS=CL=F,GC=F     # Yahoo Finance tickers to monitor

# ── Arbitrage scanner ────────────────────────────────────────
# Scans for YES+NO price gaps across Polymarket markets where
# combined cost < $1 after fees — risk-free profit if filled.

ARB_ENABLED=true                 # enable arb scanner
# ARB_MIN_EDGE=0.05              # min net edge after fees to enter (5%)
# ARB_MAX_STAKE_FRACTION=0.05    # max bankroll fraction per arb leg (5%)
# ARB_FEE_RATE=0.02              # Polymarket taker fee per trade (2%)

# ── Copytrade signals ────────────────────────────────────────
# Mirror trades from external wallets into PGA.

COPYTRADE_ENABLED=false
# COPYTRADE_WALLETS=0x...,0x...  # comma-separated proxy wallets
# COPYTRADE_MARKET_SCOPE=all       # weather,geopolitics,sports,crypto | all
# COPYTRADE_SIZE_SCALE=0.1         # scale vs observed wallet USDC size (e.g. 0.1 = 10% of whale size)
# COPYTRADE_MAX_STAKE_USD=25       # cap per order
# COPYTRADE_MAX_SLIPPAGE_BPS=200   # skip if price moved too far (200 bps = 2%)
# COPYTRADE_MIN_TIME_TO_RESOLVE_HOURS=6
# COPYTRADE_MIN_LIQUIDITY=1000
# COPYTRADE_EXIT_MODE=rules        # rules (PGA stop-loss/take-profit) | mirror (follow wallet sells)
# COPYTRADE_POLL_INTERVAL_MS=2000  # persist worker loop interval (ms)
#
# Copytrade shortlist automation (weekly refresh of COPYTRADE_WALLETS)
# COPYTRADE_SHORTLIST_TIME_WINDOW=WEEK  # DAY | WEEK | MONTH | ALL
# COPYTRADE_SHORTLIST_TOP_N=5
# COPYTRADE_SHORTLIST_MIN_PNL_USD=10000
# COPYTRADE_SHORTLIST_MIN_VOL_USD=100000
# COPYTRADE_SHORTLIST_AUTO_APPLY=true
