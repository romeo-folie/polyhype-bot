# Redis — required for deduplication and position tracking
REDIS_URL=redis://localhost:6379

# LLM Provider — one of OPENAI_API_KEY or GEMINI_API_KEY required
# Used for urgency scoring and consensus probability estimation
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...

# Simmer API — required for trade execution
# Register an agent: curl -X POST https://api.simmer.markets/api/sdk/agents/register \
#   -H "Content-Type: application/json" \
#   -d '{"name": "my-agent", "description": "Polymarket geopolitical agent"}'
# Then open the claim_url to link your Polymarket wallet (required for real USDC trading).
SIMMER_API_KEY=sk_live_...

# Telegram notifications — required for trade alerts
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=...

# Polymarket wallet — required for execution
# WARNING: never commit a funded private key; load from secret manager in prod
POLYGON_WALLET_PRIVATE_KEY=0x...

# Optional — defaults shown
# LLM_PROVIDER=openai        # openai | gemini
# OPENAI_MODEL=gpt-4o-mini   # any OpenAI chat model (e.g. gpt-4o, gpt-4.1-mini)
# GEMINI_MODEL=gemini-2.5-flash # any Gemini model (e.g. gemini-2.5-pro)
# URGENCY_THRESHOLD=8        # minimum score (1-10) to trigger market search
# DIVERGENCE_THRESHOLD=0.1   # minimum edge fraction to trigger a trade (10%)
# MAX_BET_FRACTION=0.10      # fraction of portfolio per trade (10%)
# TAKE_PROFIT_THRESHOLD=0.25 # close position when up this fraction (25%)
# STOP_LOSS_THRESHOLD=0.30   # close position when down this fraction (30%)
# REEVAL_ENABLED=true        # re-evaluate open positions against fresh OSINT each cycle
# REEVAL_EDGE_FLOOR=0.03     # exit if remaining edge drops below this (3%)
# BANKROLL_USD=100           # starting bankroll in USDC (used for position sizing)
# CLOB_FALLBACK_ENABLED=true # when Simmer can't find a market, try direct Polymarket CLOB
# CLOB_ORDER_TYPE=FAK        # FAK or FOK for CLOB market orders
# POLYMARKET_SIGNATURE_TYPE=0 # 0=browser wallet key, 1=magic/email key
# POLYMARKET_FUNDER_ADDRESS=0x... # optional; defaults to wallet address

# WebSocket price feed (Phase: ws-orderbook)
# WS_ENABLED=true            # set to false to disable CLOB WebSocket and use Gamma REST only

# Spot price monitor (Phase 5) — cron:spot
# SPOT_MONITOR_ENABLED=false # set to true to enable spot price signal pipeline
# SPOT_MOVE_THRESHOLD=3      # % price move required to trigger a signal (default: 3%)
# SPOT_LOOKBACK_MINUTES=5    # lookback window for move detection (default: 5 min)
# SPOT_COOLDOWN_MINUTES=30   # minimum minutes between trades on same asset (default: 30)
# SPOT_DIVERGENCE_THRESHOLD=0.12 # minimum edge to trade on a correlated market (default: 12%)
# SPOT_CRYPTO_ASSETS=bitcoin,ethereum # CoinGecko asset IDs to monitor
# SPOT_COMMODITY_ASSETS=CL=F,GC=F    # Yahoo Finance ticker symbols to monitor

# Arbitrage scanner (Phase: arb)
# ARB_ENABLED=true           # set to false to disable arb scanning
# ARB_MIN_EDGE=0.05          # minimum net edge after fees to enter arb (default: 5%)
# ARB_MAX_STAKE_FRACTION=0.05 # max bankroll fraction per arb leg (default: 5%)
# ARB_FEE_RATE=0.02          # Polymarket taker fee rate per trade (default: 2%)
